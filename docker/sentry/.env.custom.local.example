# Local overrides for an upstream getsentry/self-hosted checkout used for
# developer testing without the shared reverse proxy or ACME.

# Bind nginx directly on localhost for manual browser validation.
SENTRY_BIND=127.0.0.1:9001

# Keep local container names isolated from any production-style checkout.
COMPOSE_PROJECT_NAME=sciona-sentry-local

# Start with the full stack so local validation is representative.
COMPOSE_PROFILES=feature-complete

# Keep the version in sync with docker/sentry/bootstrap.sh.
SENTRY_IMAGE=ghcr.io/getsentry/sentry:26.3.1
SNUBA_IMAGE=ghcr.io/getsentry/snuba:26.3.1
RELAY_IMAGE=ghcr.io/getsentry/relay:26.3.1
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.3.1
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:26.3.1
VROOM_IMAGE=ghcr.io/getsentry/vroom:26.3.1
UPTIME_CHECKER_IMAGE=ghcr.io/getsentry/uptime-checker:26.3.1
