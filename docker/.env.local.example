# =============================================================================
# docker/.env.local.example — Local, no-TLS defaults for infrastructure testing
# =============================================================================

# --- Domain ------------------------------------------------------------------
DOMAIN=localhost

# --- Local bridge networks ---------------------------------------------------
SCIONA_PROXY_TIER_NETWORK=sciona-local-proxy
SCIONA_BACKEND_NETWORK=sciona-local-backend

# --- Proxy / ACME ------------------------------------------------------------
# Unused in local mode, but retained for consistency.
ACME_EMAIL=admin@localhost

# --- Direct localhost bindings -----------------------------------------------
AUTHENTIK_LOCAL_BIND=9000
TEMPORAL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Authentik ----------------------------------------------------------------
AUTHENTIK_PG_PASSWORD=change-me-authentik-pg
AUTHENTIK_SECRET_KEY=change-me-generate-64-char-random-string
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# --- Temporal -----------------------------------------------------------------
TEMPORAL_PG_PASSWORD=change-me-temporal-pg

# --- Sentry ------------------------------------------------------------------
# Local Sentry is optional and managed by docker/manage-local.sh --with-sentry.
SENTRY_SELF_HOSTED_VERSION=26.3.1
SENTRY_DSN=

# --- OpenTelemetry -----------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sciona-api
SCIONA_ENV=development

# --- OPA Policy Engine -------------------------------------------------------
OPA_URL=http://localhost:8181
OPA_POLICY_MODE=permissive
OPA_TIMEOUT_S=2

# --- Enterprise Auth ---------------------------------------------------------
ENTERPRISE_CALLBACK_URL=http://localhost:8000/auth/enterprise/callback
SCIM_BEARER_TOKEN=
